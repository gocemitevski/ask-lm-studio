{
  "manifest_version": 3,
  "name": "Ask LM Studio",
  "version": "1.0.1",
  "description": "Use LM Studio local models directly in the Firefox sidebar. Local-first: defaults to localhost; page attachment needs http/https access to extract text.",
  "homepage_url": "https://lmstudio.ai",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "menus",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "sidebar_action": {
    "default_panel": "sidebar/sidebar.html",
    "default_title": "Ask LM Studio",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "open_at_install": false
  },
  "action": {
    "default_title": "Open Ask LM Studio Sidebar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "background": {
    "scripts": ["background/background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "lm-studio-sidebar@example.local",
      "strict_min_version": "121.0"
    }
  }
}
